SERVICE_NAME=tts-backend
VERSION=0.1.0
ENVIRONMENT=production
LOG_LEVEL=INFO

TTS_DEFAULT_PROVIDER=kokoro

# Both engines can return word_timings. ONNX requires a duration-bearing graph
# from model-files-v1.1, not the legacy audio-only graph with the same filename.
TTS_ENGINE=kokoro-onnx
KOKORO_REQUIRE_TIMINGS=true
KOKORO_CUSTOM_VOICES_DIR=~/.local/share/tts/voices
# kokoro-torch only. Language for KPipeline's G2P; "a" = American English.
KOKORO_TORCH_LANG_CODE=a
# kokoro-torch only. Leave unset for the kokoro package's default weights repo.
# KOKORO_TORCH_REPO_ID=hexgrad/Kokoro-82M

KOKORO_ENABLED=true
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_MODEL_PATH=/Users/mini2/.cache/tts/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=/Users/mini2/.cache/tts/voices-v1.0.bin

KITTEN_ENABLED=true
KITTEN_MODEL_ID=KittenML/kitten-tts-mini-0.8

TTS_SAMPLE_RATE=24000
CORS_ORIGINS=https://api.nonagentic.ai,https://w2v.nonagentic.ai

# Licence entitlement gate on /api/tts (w2v_common LICENSE_GATE). ARMED in prod
# since 2026-09-14 (gitops tts-backend-env ConfigMaps).
W2V_LICENSE_GATE_ENABLED=true
# Licence app keys the entitlement gate accepts (w2v-common >=0.111.0). This is a
# shared platform `speech` service (owner 2026-10-22): entitled if the tenant holds
# ANY listed key. Unset/blank = `w2v` only (pre-0.111.0 behaviour).
W2V_LICENSE_GATE_APP_KEYS=speech,w2v
# Fast path: a caller presenting its OWN licence token for one of these keys
# (active, same tenant, not delegated) is entitled without the /licenses/active
# lookup. Must be a subset of W2V_LICENSE_GATE_APP_KEYS. Default empty = off.
W2V_LICENSE_GATE_TOKEN_APP_KEYS=speech
# If AUTH_LICENSE_APP_KEYS is ever set, it must include `speech` too, or the
# auth middleware refuses speech licence tokens before the gate runs.
